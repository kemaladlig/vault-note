# Copy to .env.local (git-ignored) and fill in.
#
# 1. Google Cloud Console → APIs & Services → enable "Google Drive API".
# 2. Credentials → Create OAuth client ID.
# 3. Add your dev/prod origins (http://localhost:5173, capacitor://localhost, https://...).
# 4. Paste the client id(s) below.
#
# Web (GIS token flow) and native (PKCE + custom redirect) are separate OAuth clients.
# If only one is set, it is used for both (see src/features/sync/auth/config.ts).
VITE_GOOGLE_CLIENT_ID_WEB=
VITE_GOOGLE_CLIENT_ID_NATIVE=
# Optional: a single shared id, used when the platform-specific ones are unset.
VITE_GOOGLE_CLIENT_ID=
#
# Native (Capacitor) builds additionally need:
#   - the custom redirect URI  com.vaultnote.app://oauth2redirect  registered on the native client
#     (see src/features/sync/auth/nativePkceAuth.ts + the intent-filter in AndroidManifest.xml),
#   - and, for Android, the signing certificate SHA-1 registered on the OAuth client.
